// owner: src/utility/payments
model Payment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  txnId          String    @unique @map("txn_id")
  provider       String
  amountPaise    Int       @map("amount_paise")
  currency       String    @default("INR")
  productInfo    String    @map("product_info")
  payer          Json
  subjectType    String    @map("subject_type")
  subjectId      String    @map("subject_id")
  status         String    @default("CREATED")
  returnUrl      String    @map("return_url")
  providerRef    String?   @map("provider_ref")
  succeededAt    DateTime? @map("succeeded_at")
  lastVerifiedAt DateTime? @map("last_verified_at")
  refundedPaise  Int       @default(0) @map("refunded_paise")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, subjectType, subjectId])
  @@map("util_pay_payment")
}

model PaymentEvent {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  paymentId    String?  @map("payment_id")
  txnId        String?  @map("txn_id")
  kind         String
  payload      Json
  hashValid    Boolean? @map("hash_valid")
  resultStatus String?  @map("result_status")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, paymentId])
  @@map("util_pay_event")
}

model PaymentRefund {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  paymentId   String   @map("payment_id")
  amountPaise Int      @map("amount_paise")
  status      String
  reason      String?
  providerRef String?  @map("provider_ref")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("util_pay_refund")
}
