{
  "name": "@hsrp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm run lint:deps && nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs && node scripts/check-module-tables.cjs",
    "test": "jest --runInBand",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema --script",
    "seed": "tsx src/seed/run.ts",
    "demo:e2e": "tsx scripts/demo-e2e.ts"
  },
  "prisma": {
    "schema": "prisma/schema"
  },
  "dependencies": {
    "@hsrp/contracts": "workspace:*",
    "@nestjs/common": "10.4.15",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.0",
    "@nestjs/throttler": "6.3.0",
    "@prisma/client": "6.16.2",
    "csv-parse": "5.6.0",
    "nestjs-zod": "3.0.0",
    "pdfkit": "0.15.2",
    "prisma": "6.16.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "swagger-ui-express": "5.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@swc/core": "1.10.1",
    "@swc/jest": "0.2.37",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/pdfkit": "0.13.8",
    "dependency-cruiser": "16.8.0",
    "jest": "29.7.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  }
}
