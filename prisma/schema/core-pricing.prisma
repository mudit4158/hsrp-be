// owner: src/core/pricing
/// Effective-dated price. Null oemCode / vehicleType = applies to all. Most specific match wins.
model PriceRule {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  stateCode     String    @map("state_code")
  vehicleClass  String    @map("vehicle_class")
  vehicleType   String?   @map("vehicle_type")
  oemCode       String?   @map("oem_code")
  orderType     String    @map("order_type")
  plateSet      String    @default("BOTH") @map("plate_set")
  amountPaise   Int       @map("amount_paise")
  published     Boolean   @default(false)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, stateCode, vehicleClass, orderType])
  @@map("core_price_rule")
}

/// Extra charge added on top of the base price when its conditions match (e.g. {"greenStrip": true}).
model ExtraCharge {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  code          String
  name          String
  amountPaise   Int       @map("amount_paise")
  conditions    Json
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("core_price_extra_charge")
}
