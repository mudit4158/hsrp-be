// owner: src/utility/identity
model IamOrg {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  orgType     String   @map("org_type")
  parentId    String?  @map("parent_id")
  externalRef String?  @map("external_ref")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("util_iam_org")
}

model IamRole {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  permissions String[]
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("util_iam_role")
}

model IamUser {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  username     String
  displayName  String    @map("display_name")
  passwordHash String    @map("password_hash")
  orgId        String?   @map("org_id")
  roles        String[]
  mobile       String?
  email        String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, username])
  @@map("util_iam_user")
}

model IamOtp {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  purpose    String
  recipient  String
  codeHash   String    @map("code_hash")
  context    Json?
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  verifiedAt DateTime? @map("verified_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, recipient])
  @@map("util_iam_otp")
}

model IamApiClient {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  orgId     String   @map("org_id")
  name      String
  keyHash   String   @unique @map("key_hash")
  /// Shared secret used to verify request signatures (HMAC-SHA256). Prototype stores it in clear.
  secret    String
  roles     String[]
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("util_iam_api_client")
}

model IamDevice {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  userId     String   @map("user_id")
  deviceId   String   @map("device_id")
  name       String?
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, userId, deviceId])
  @@map("util_iam_device")
}
