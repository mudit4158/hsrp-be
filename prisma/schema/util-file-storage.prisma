// owner: src/utility/file-storage
model FileObject {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  filename         String
  mimeType         String    @map("mime_type")
  sizeBytes        Int       @map("size_bytes")
  sha256           String
  storageKey       String    @map("storage_key")
  purpose          String?
  ownerSubjectType String?   @map("owner_subject_type")
  ownerSubjectId   String?   @map("owner_subject_id")
  retentionUntil   DateTime? @map("retention_until")
  createdBy        String?   @map("created_by")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, ownerSubjectType, ownerSubjectId])
  @@map("util_file_object")
}
