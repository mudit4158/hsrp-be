// owner: src/adapters
/// Fictional VAHAN records served by the mock VehicleRegistry.
model MockVahanVehicle {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  regnNo             String   @unique @map("regn_no")
  chassisNo          String   @map("chassis_no")
  engineNo           String   @map("engine_no")
  stateCd            String   @map("state_cd")
  offCd              String   @map("off_cd")
  maker              String
  fuel               String
  vchType            String   @map("vch_type")
  vchCatg            String   @map("vch_catg")
  norms              String
  regnDate           String   @map("regn_date")
  hsrpFrontLaserCode String?  @map("hsrp_front_laser_code")
  hsrpRearLaserCode  String?  @map("hsrp_rear_laser_code")
  scenario           String?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("adp_mock_vahan_vehicle")
}

model MockOemCatalogue {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  oemCode   String   @map("oem_code")
  chassisNo String   @map("chassis_no")
  model     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([oemCode, chassisNo])
  @@map("adp_mock_oem_catalogue")
}

model MockSetting {
  key       String   @id
  tenantId  String   @map("tenant_id")
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adp_mock_setting")
}

model MockPayuTxn {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  txnid     String   @unique
  amount    String
  status    String   @default("initiated")
  mihpayid  String?
  request   Json
  refunds   Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adp_mock_payu_txn")
}

/// Every SMS and email "sent" by the mock MessageSender. Nothing leaves the machine.
model MockOutboundMessage {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  channel       String
  to            String
  senderId      String   @map("sender_id")
  dltTemplateId String?  @map("dlt_template_id")
  subject       String?
  body          String
  providerRef   String   @map("provider_ref")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("adp_mock_outbound_message")
}

/// Status callbacks the mock OrderSource "sent" back to OEM systems.
model MockOemCallback {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  oemCode   String   @map("oem_code")
  orderRef  String   @map("order_ref")
  status    String
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adp_mock_oem_callback")
}

/// Bytes for the database-backed FileStore (decision D13).
model FileBlob {
  key       String   @id
  tenantId  String   @map("tenant_id")
  data      Bytes
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("adp_filestore_blob")
}
