// owner: src/utility/scheduling
model SchedResource {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  code        String
  name        String
  subjectType String?  @map("subject_type")
  subjectId   String?  @map("subject_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("util_sched_resource")
}

/// Weekly capacity calendar: on `weekday` (0 = Sunday) slots of `slotMinutes` from start to end, each with `capacity` bookings.
model SchedCalendarRule {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  resourceId  String   @map("resource_id")
  weekday     Int
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  slotMinutes Int      @map("slot_minutes")
  capacity    Int
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([resourceId, weekday])
  @@map("util_sched_calendar_rule")
}

model SchedClosure {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  resourceId String   @map("resource_id")
  date       String
  reason     String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([resourceId, date])
  @@map("util_sched_closure")
}

model SchedBooking {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  resourceId  String   @map("resource_id")
  date        String
  slotStart   String   @map("slot_start")
  status      String   @default("BOOKED")
  subjectType String   @map("subject_type")
  subjectId   String   @map("subject_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([resourceId, date, slotStart, status])
  @@map("util_sched_booking")
}
