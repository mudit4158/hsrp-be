// owner: src/core/fitment
model Fitment {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  orderId        String    @unique @map("order_id")
  dealerId       String    @map("dealer_id")
  frontLaserCode String?   @map("front_laser_code")
  rearLaserCode  String?   @map("rear_laser_code")
  frontPhotoId   String?   @map("front_photo_id")
  rearPhotoId    String?   @map("rear_photo_id")
  chassisPhotoId String?   @map("chassis_photo_id")
  fittedAt       DateTime  @map("fitted_at")
  recordedBy     String?   @map("recorded_by")
  deviceId       String?   @map("device_id")
  latitude       Float?
  longitude      Float?
  vahanStatus    String    @default("PENDING") @map("vahan_status")
  vahanReply     String?   @map("vahan_reply")
  postedAt       DateTime? @map("posted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([tenantId, vahanStatus])
  @@map("core_fit_fitment")
}

/// Every OCR reading of a fitment photo (D45), kept also when the fitment is refused because a plate photo does not
/// read the order's registration number. fitmentId is set when the fitment was recorded.
model FitmentPhotoCheck {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  orderId    String   @map("order_id")
  fitmentId  String?  @map("fitment_id")
  position   String
  fileId     String?  @map("file_id")
  expected   String
  readText   String?  @map("read_text")
  confidence Int?
  engine     String
  result     String
  reason     String
  actorId    String?  @map("actor_id")
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("core_fit_photo_check")
}
