// owner: src/core/masters
model State {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  rulePack  String   @map("rule_pack")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_state")
}

model Company {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  address   String?
  gstin     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_company")
}

model Station {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  companyId String   @map("company_id")
  stateCode String   @map("state_code")
  city      String
  address   String?
  orgId     String?  @map("org_id")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_station")
}

model Oem {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  code                   String
  name                   String
  integration            String
  requiresCatalogueCheck Boolean  @default(false) @map("requires_catalogue_check")
  orgId                  String?  @map("org_id")
  walletAccountId        String?  @map("wallet_account_id")
  importProfileCode      String?  @map("import_profile_code")
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_oem")
}

model Dealer {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  code                  String
  name                  String
  stateCode             String   @map("state_code")
  city                  String
  address               String?
  mobile                String?
  email                 String?
  stationId             String   @map("station_id")
  orgId                 String?  @map("org_id")
  walletGroup           String   @map("wallet_group")
  walletAccountId       String?  @map("wallet_account_id")
  acceptsCustomerOrders Boolean  @default(true) @map("accepts_customer_orders")
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_dealer")
}

model DealerOem {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  dealerId  String   @map("dealer_id")
  oemId     String   @map("oem_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([dealerId, oemId])
  @@map("core_mst_dealer_oem")
}

model Product {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  code      String
  name      String
  sizeMm    String   @map("size_mm")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@map("core_mst_product")
}

/// Maps a VAHAN vehicle category to our vehicle class/type and the plate products it needs.
model VehicleCategory {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  vahanCategory    String   @map("vahan_category")
  description      String
  vehicleClass     String   @map("vehicle_class")
  vehicleType      String   @map("vehicle_type")
  frontProductCode String   @map("front_product_code")
  rearProductCode  String   @map("rear_product_code")
  stickerRequired  Boolean  @default(false) @map("sticker_required")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, vahanCategory])
  @@map("core_mst_vehicle_category")
}
