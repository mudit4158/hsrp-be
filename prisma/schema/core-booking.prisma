// owner: src/core/booking
model Booking {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  orderId         String   @unique @map("order_id")
  dealerId        String   @map("dealer_id")
  schedBookingId  String   @map("sched_booking_id")
  slotDate        String   @map("slot_date")
  slotStart       String   @map("slot_start")
  status          String   @default("BOOKED")
  rescheduleCount Int      @default(0) @map("reschedule_count")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([dealerId, slotDate])
  @@map("core_bkg_booking")
}
