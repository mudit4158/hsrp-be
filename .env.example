# Copy to .env and adjust. Docker Compose and the API read .env from this folder.

# ---- Database ----
POSTGRES_USER=hsrp
POSTGRES_PASSWORD=hsrp_local_only
POSTGRES_DB=hsrp
# Host port for PostgreSQL (5433 avoids clashing with a locally installed PostgreSQL).
POSTGRES_PORT=5433
# Used by the API when run outside Docker (pnpm dev:api, pnpm seed, tests).
DATABASE_URL=postgresql://hsrp:hsrp_local_only@localhost:5433/hsrp
# Separate database for the automated tests (created automatically by the test setup).
TEST_DATABASE_URL=postgresql://hsrp:hsrp_local_only@localhost:5433/hsrp_test
# FastAPI port (D48): PY_<NAME> overrides <NAME> for the Python API only (its own database, port and URLs while
# both backends run); removed at cut-over.
PY_DATABASE_URL=postgresql://hsrp:hsrp_local_only@localhost:5433/hsrp_py
PY_API_PORT=3001
PY_PUBLIC_API_URL=http://localhost:3001
PY_INTERNAL_API_URL=http://localhost:3001

# ---- API ----
API_PORT=3000
# 0.0.0.0 so a phone on the same Wi-Fi can reach the API.
API_HOST=0.0.0.0
# Public base URL of the API as seen by browsers (used for the mock payment gateway redirects).
PUBLIC_API_URL=http://localhost:3000
# Public base URL of the web app (payment return pages, links in SMS).
PUBLIC_WEB_URL=http://localhost:8080
JWT_SECRET=change-me-local-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=8h
# Signs short-lived file download links.
FILE_LINK_SECRET=change-me-file-link-secret
# Runs the outbox poller, retries and scheduled jobs inside the API process.
WORKER_ENABLED=true
# Base delay in milliseconds for outbox retries (doubles each attempt, capped at 5 minutes).
OUTBOX_RETRY_BASE_MS=5000
# Demo conveniences: accept the fixed OTP below. Never enable outside a demo.
DEMO_MODE=true
DEMO_FIXED_OTP=123456
# Password given to every seeded user. Required by the seed.
SEED_PASSWORD=
# Set to true to wipe and reseed on start (Docker). Otherwise seeding is skipped if data exists.
SEED_RESET=false
DEFAULT_TENANT_ID=t-demo

# ---- Adapters (mock | real). Only mock is implemented in the prototype. ----
VAHAN_ADAPTER=mock
PAYMENT_ADAPTER=mock
MESSAGE_ADAPTER=mock
OEM_ADAPTER=mock
FILE_STORE_ADAPTER=db
# Plate OCR (D45): tesseract = real OCR in the API process (default); mock = reads the plate text test images embed.
OCR_ADAPTER=tesseract

# Mock PayU merchant (fictional values; the mock gateway checks the SHA-512 hash with them).
PAYU_MERCHANT_KEY=MOCKKEY
PAYU_MERCHANT_SALT=mock-salt-not-secret

